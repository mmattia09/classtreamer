# ─── Required ────────────────────────────────────────────────────────────────
# The app refuses to start in production without these two.

# Plain password, or a bcrypt hash (a value starting with $2 is treated as one).
ADMIN_PASSWORD="cambia-questa-password"
# Signs the admin session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET="cambia-questa-stringa-lunga"


# ─── Deployment ──────────────────────────────────────────────────────────────

# Image tag Docker Compose pulls. Pin a release (e.g. "1.2.0") to control when
# you upgrade; the default follows the latest push to main.
APP_TAG="latest"

# Host port the app is published on.
PORT="3000"

# Public URL the app is reachable at. Used for the QR code shown on the
# classroom displays, so it has to be an address students' phones can reach.
PUBLIC_URL="http://localhost:3000"

# Leave empty to decide from the request protocol.
# Force to "true" when running behind an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=""


# ─── Database ────────────────────────────────────────────────────────────────
# The connection URL is derived from these; it is never written by hand.

DB_NAME="classtreamer"
DB_USER="classtreamer"
DB_PASSWORD="classtreamer"


# ─── Rate limiting ───────────────────────────────────────────────────────────
# Students are limited per device. These per-IP limits are only a flood guard
# against a script: a school NATs every phone behind one address, so they sit
# far above a real assembly. The defaults fit roughly 3000 students answering
# at the same moment.

ANSWER_IP_RATE_LIMIT="3000"
AUDIENCE_QUESTION_IP_RATE_LIMIT="600"


# ─── Development ─────────────────────────────────────────────────────────────

# debug | info | warn | error. Defaults to info in production, debug elsewhere.
LOG_LEVEL=""

# Ports Postgres and Redis are published on for local development, where the
# app runs on the host instead of in a container. Used only by
# docker-compose.dev.yaml; change them if 5432 or 6379 are already taken.
DB_HOST_PORT="5432"
REDIS_HOST_PORT="6379"
