# Port the app is published on by Docker
PORT="3000"
# Public URL the app is reachable at — used for redirects and the answer QR code
PUBLIC_URL="http://localhost:3000"

# Admin access
# Plain password or a bcrypt hash (a value starting with $2 is treated as a hash).
# The app refuses to start without it.
ADMIN_PASSWORD="cambia-questa-password"
# Signs the admin session cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET="cambia-questa-stringa-lunga"
# Leave empty to decide automatically from the request protocol.
# Force to "true" when running behind an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=""

# Database credentials — the connection URL is derived from these
DB_NAME="classtreamer"
DB_USER="classtreamer"
DB_PASSWORD="classtreamer"

# Host ports the containers are published on, loopback only.
# Change these if 5432 or 6379 are already taken on your machine.
DB_HOST_PORT="5432"
REDIS_HOST_PORT="6379"
